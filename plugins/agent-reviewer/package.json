{
  "name": "agent-reviewer",
  "version": "0.3.1",
  "type": "module",
  "description": "Clone your team's best code reviewers from their PR history and run them as a review panel.",
  "homepage": "https://github.com/ivankuznetsov/agent-plugins",
  "repository": "https://github.com/ivankuznetsov/agent-plugins",
  "license": "MIT",
  "keywords": [
    "agent-reviewer",
    "agent-skills",
    "code-review",
    "reviewer-persona"
  ],
  "pi": {
    "skills": [
      "./pi/skills"
    ]
  },
  "openclaw": {
    "extensions": [
      "./openclaw/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-beta.2"
    }
  },
  "x-agent-plugins-generated": "scripts/generate-agent-packages.py"
}
