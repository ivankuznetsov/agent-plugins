#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'agent_seo'
require 'json'
require 'optparse'

options = {}

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: seo-scrub [options]'
  opts.separator ''
  opts.separator 'Audit formatting controls and em dashes without changing content.'
  opts.separator 'The legacy command name is retained for compatibility.'
  opts.separator ''
  opts.separator 'Options:'

  opts.on('-f', '--file FILE', 'Markdown file to audit (reads from stdin if omitted)') do |file|
    options[:file] = file
  end

  opts.on('--stats', 'Retained for compatibility; the human report already includes statistics')

  opts.on('-o', '--output FILE', 'Unsupported in 2.0; the audit never writes files') do |file|
    options[:output] = file
  end

  opts.on('--json', 'Output audit statistics as JSON') do
    options[:json] = true
  end

  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  warn "Error: #{e.message}"
  exit 2
end

if options[:output]
  warn 'Error: --output was removed in Agent SEO 2.0; the formatting audit is read-only.'
  exit 2
end

begin
  stats = if options[:file]
            AgentSeo::ContentScrubber.scrub_file(options[:file])
          elsif !$stdin.tty?
            _unchanged_content, stdin_stats = AgentSeo::ContentScrubber.new.scrub($stdin.read)
            stdin_stats
          else
            warn 'Error: No content provided. Use -f FILE or pipe content to stdin.'
            exit 1
          end
rescue ArgumentError, SystemCallError, Encoding::InvalidByteSequenceError, Encoding::UndefinedConversionError => e
  warn "Error: #{e.message}"
  exit 1
end

if options[:json]
  puts JSON.pretty_generate(stats)
else
  puts AgentSeo::ContentScrubber.report_lines(stats)
end
