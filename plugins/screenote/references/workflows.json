{
  "contract_version": 2,
  "provenance": {
    "pull_request": "https://github.com/ivankuznetsov/screenote-cli/pull/18",
    "merge_sha": "cce90049d1335413bd903d7da4882d20615fa5d3",
    "minimum_release": "0.4.1"
  },
  "success": {
    "exit_code": 0,
    "output": "one complete JSON value on stdout unless the command declares json_lines"
  },
  "commands": {
    "project list": {
      "collection": "projects",
      "required_flags": [],
      "paginated": false
    },
    "project create": {
      "object": "project",
      "required_flags": ["--name"],
      "paginated": false
    },
    "page list": {
      "collection": "pages",
      "required_flags": [],
      "paginated": false
    },
    "screenshot list": {
      "collection": "screenshots",
      "required_flags": ["--page", "--status", "--limit", "--offset"],
      "paginated": true
    },
    "screenshot create": {
      "required_flags": ["--title", "--page", "--file"],
      "paginated": false
    },
    "annotation list": {
      "collection": "annotations",
      "required_flags": ["--screenshot", "--status", "--viewport", "--limit", "--offset"],
      "paginated": true
    },
    "annotation get": {
      "required_flags": ["--annotation", "--crop-file", "--attachments-dir"],
      "paginated": false
    },
    "comment add": {
      "required_flags": ["--annotation", "--body", "--image"],
      "paginated": false
    },
    "snapshot --manifest": {
      "required_flags": ["--manifest", "--wait"],
      "output": "json_lines",
      "terminal_event": "snapshot_ready",
      "paginated": false
    }
  },
  "workflows": {
    "screenote": {
      "skill": "skills/screenote/SKILL.md",
      "input_modes": ["browser_capture", "existing_image"],
      "conditional_commands": ["project create"],
      "ordered_commands": ["project list", "snapshot --manifest"]
    },
    "snapshot": {
      "skill": "skills/snapshot/SKILL.md",
      "conditional_commands": ["project create"],
      "ordered_commands": ["project list", "snapshot --manifest"]
    },
    "feedback": {
      "skill": "skills/feedback/SKILL.md",
      "ordered_commands": [
        "project list",
        "page list",
        "screenshot list",
        "annotation list",
        "annotation get",
        "comment add"
      ]
    }
  }
}
